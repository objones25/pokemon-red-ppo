# scripts/setup.sh writes .env (gitignored) and asks for the W&B key itself, so nothing here needs editing by hand.

# W&B API key: https://wandb.ai/authorize
WANDB_API_KEY=

# Optional: W&B entity (username or team); absent uses the key's default
WANDB_ENTITY=

# Optional: Runpod API key to delete this pod when training ends; absent uses the key Runpod gives each pod
RUNPOD_API_KEY=
