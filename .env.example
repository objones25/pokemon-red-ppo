# scripts/setup.sh asks for these and writes .env (mode 0600, gitignored).

# W&B API key: https://wandb.ai/authorize
WANDB_API_KEY=

# W&B entity (username or team); empty uses the key's default
WANDB_ENTITY=

# Runpod API key, used only to delete this pod when training ends: Runpod console, Settings, API Keys
RUNPOD_API_KEY=
